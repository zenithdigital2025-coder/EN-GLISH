    // ===================== NETTOYAGE DES INPUTS (anti-accents) =====================
    function sanitizeInput(event) {
        const input = event.target;
        // 1. Normalise NFD pour séparer les accents
        // 2. Supprime les diacritiques
        // 3. Ne garde que les lettres A-Z a-z
        const sanitized = input.value
            .normalize('NFD')
            .replace(/[\u0300-\u036f]/g, '')
            .replace(/[^a-zA-Z]/g, '');

        if (input.value !== sanitized) {
            const pos = input.selectionStart;
            input.value = sanitized;
            // Repositionne le curseur approximativement
            const newPos = Math.max(0, Math.min(sanitized.length, pos - (input.value.length - sanitized.length)));
            try { input.setSelectionRange(newPos, newPos); } catch (e) {}
        }
    }

