<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="theme-color" content="#2563eb">
    <title>Révision - Verbes irréguliers</title>
    <style>
        :root {
            --primary: #2563eb;
            --primary-hover: #1d4ed8;
            --bg: #f8fafc;
            --card-bg: #ffffff;
            --text: #1e293b;
            --muted: #64748b;
            --correct: #16a34a;
            --wrong: #dc2626;
            --border: #e2e8f0;
            --surface: #f1f5f9;
        }

        @media (prefers-color-scheme: dark) {
            :root {
                --primary: #3b82f6;
                --primary-hover: #60a5fa;
                --bg: #0f172a;
                --card-bg: #1e293b;
                --text: #e2e8f0;
                --muted: #94a3b8;
                --correct: #4ade80;
                --wrong: #f87171;
                --border: #334155;
                --surface: #0f172a;
            }
            .card, .bubble-section, .modal-content { background: #334155 !important; }
            .card .french-word { color: #f1f5f9 !important; }
            .btn-list { background: #334155; color: #cbd5e1; }
            .btn-list:hover { background: #475569; }
            .bubble-btn { background: #1e293b; color: var(--text); }
            .bubble-btn:hover { background: #0f172a; }
            .next-card-btn { background: #e2e8f0; color: #0f172a; }
            .next-card-btn:hover { background: #cbd5e1; }
            .verb-table th { background: #1e293b; color: #cbd5e1; }
            .explanation-box.correct { background: #14532d; color: #bbf7d0; border-color: #166534; }
            .explanation-box.wrong { background: #7f1d1d; color: #fecaca; border-color: #991b1b; }
            input[type="text"] { background: #0f172a; color: var(--text); }
        }

        * {
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            margin: 0;
            padding: 0;
        }

        body {
            background-color: var(--bg);
            color: var(--text);
            display: flex;
            justify-content: center;
            align-items: flex-start;
            min-height: 100vh;
            padding: 20px;
            transition: background-color 0.3s;
        }

        .container {
            background: var(--card-bg);
            border-radius: 16px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.08);
            width: 100%;
            max-width: 520px;
            padding: 24px;
        }

        .header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            flex-wrap: wrap;
            gap: 8px;
        }

        .header h1 {
            font-size: 1.4rem;
            color: var(--primary);
        }

        .header-buttons {
            display: flex;
            gap: 6px;
            flex-wrap: wrap;
        }

        .btn-list {
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 6px 12px;
            border-radius: 8px;
            font-size: 0.8rem;
            font-weight: 600;
            color: var(--muted);
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-list:hover {
            background: var(--border);
            color: var(--text);
        }

        .btn-list:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .stats {
            font-size: 0.9rem;
            color: var(--muted);
            margin-bottom: 14px;
            padding-bottom: 12px;
            border-bottom: 1px solid var(--border);
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
        }

        .progress-container {
            flex: 1;
            height: 6px;
            background: var(--border);
            border-radius: 3px;
            overflow: hidden;
        }

        .progress-bar {
            height: 100%;
            background: var(--primary);
            width: 0%;
            transition: width 0.4s ease;
            border-radius: 3px;
        }

        .card {
            background: var(--surface);
            border-radius: 12px;
            padding: 20px;
            text-align: center;
            margin-bottom: 20px;
            position: relative;
            animation: fadeIn 0.3s ease;
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(6px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .card .french-word {
            font-size: 1.4rem;
            font-weight: bold;
            color: var(--text);
        }

        .card .base-verb {
            font-size: 0.95rem;
            color: var(--muted);
            margin-top: 4px;
        }

        .btn-speak {
            position: absolute;
            top: 12px;
            right: 12px;
            background: transparent;
            border: none;
            font-size: 1.2rem;
            cursor: pointer;
            opacity: 0.6;
            transition: opacity 0.2s, transform 0.2s;
        }

        .btn-speak:hover { opacity: 1; transform: scale(1.15); }

        .input-group {
            margin-bottom: 14px;
            text-align: left;
        }

        .input-group label {
            display: block;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 4px;
            color: var(--muted);
        }

        input[type="text"] {
            width: 100%;
            padding: 12px;
            border: 2px solid var(--border);
            border-radius: 8px;
            font-size: 1rem;
            outline: none;
            transition: border-color 0.2s;
            background: var(--card-bg);
            color: var(--text);
        }

        input[type="text"]:focus { border-color: var(--primary); }
        input[type="text"].input-correct { border-color: var(--correct); }
        input[type="text"].input-wrong { border-color: var(--wrong); }

        .btn-container {
            display: flex;
            gap: 10px;
        }

        .btn {
            flex: 1;
            padding: 14px;
            border: none;
            border-radius: 8px;
            background: var(--primary);
            color: white;
            font-size: 1rem;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
        }

        .btn:hover { background: var(--primary-hover); }
        .btn:active { transform: scale(0.98); }

        .btn-dont-know {
            background: #cbd5e1;
            color: #334155;
        }

        .btn-dont-know:hover { background: #94a3b8; }

        .feedback {
            margin-top: 16px;
            padding: 12px;
            border-radius: 8px;
            text-align: center;
            font-weight: 600;
            display: none;
        }

        .feedback.correct {
            background: #dcfce7;
            color: var(--correct);
            display: block;
            animation: pop 0.3s ease;
        }

        .feedback.wrong {
            background: #fee2e2;
            color: var(--wrong);
            display: block;
        }

        @keyframes pop {
            0% { transform: scale(0.9); opacity: 0.5; }
            60% { transform: scale(1.03); }
            100% { transform: scale(1); opacity: 1; }
        }

        .bubble-section {
            margin-top: 16px;
            display: none;
            background: var(--surface);
            border: 2px dashed var(--border);
            border-radius: 12px;
            padding: 16px;
            text-align: center;
            animation: fadeIn 0.3s ease;
        }

        .bubble-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 8px;
        }

        .bubble-title {
            font-size: 0.85rem;
            color: var(--muted);
            font-weight: 600;
        }

        .btn-translate {
            background: #e2e8f0;
            border: none;
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: bold;
            color: #475569;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-translate:hover { background: #cbd5e1; }

        .sentence {
            font-size: 1.05rem;
            color: var(--text);
            margin-bottom: 12px;
            font-style: italic;
        }

        .bubbles-container {
            display: flex;
            gap: 8px;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 12px;
        }

        .bubble-btn {
            background: var(--card-bg);
            border: 2px solid var(--border);
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
            color: var(--text);
        }

        .bubble-btn:hover:not(:disabled) {
            border-color: var(--primary);
            background: #eff6ff;
        }

        .bubble-btn:disabled { cursor: not-allowed; opacity: 0.7; }

        .bubble-btn.correct-bubble {
            background: #dcfce7 !important;
            border-color: var(--correct) !important;
            color: var(--correct) !important;
            opacity: 1;
        }

        .bubble-btn.wrong-bubble {
            background: #fee2e2 !important;
            border-color: var(--wrong) !important;
            color: var(--wrong) !important;
            opacity: 1;
        }

        .shortcut-hint {
            font-size: 0.75rem;
            color: var(--muted);
            margin-top: 4px;
        }

        .explanation-box {
            font-size: 0.88rem;
            line-height: 1.6;
            padding: 14px;
            border-radius: 10px;
            display: none;
            text-align: left;
            margin-top: 12px;
        }

        .explanation-box.correct {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            color: #166534;
            display: block;
        }

        .explanation-box.wrong {
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #991b1b;
            display: block;
        }

        .explanation-title {
            font-weight: bold;
            font-size: 0.95rem;
            margin-bottom: 6px;
            display: block;
        }

        .explanation-section {
            margin-top: 8px;
            padding-top: 8px;
            border-top: 1px dashed rgba(0,0,0,0.1);
        }

        .next-card-btn {
            margin-top: 14px;
            width: 100%;
            background: #0f172a;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            font-size: 0.95rem;
            cursor: pointer;
            display: none;
        }

        .next-card-btn:hover { background: #334155; }

        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            padding: 20px;
            z-index: 100;
        }

        .modal-content {
            background: var(--card-bg);
            border-radius: 16px;
            width: 100%;
            max-width: 560px;
            max-height: 80vh;
            display: flex;
            flex-direction: column;
            padding: 20px;
            box-shadow: 0 15px 30px rgba(0,0,0,0.2);
        }

        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 14px;
            padding-bottom: 10px;
            border-bottom: 1px solid var(--border);
        }

        .modal-header h2 {
            font-size: 1.2rem;
            color: var(--primary);
        }

        .close-btn {
            background: none;
            border: none;
            font-size: 1.5rem;
            cursor: pointer;
            color: var(--muted);
        }

        .close-btn:hover { color: var(--text); }

        .modal-body {
            overflow-y: auto;
            flex: 1;
            padding-right: 4px;
        }

        .verb-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 0.9rem;
        }

        .verb-table th, .verb-table td {
            padding: 10px 8px;
            border-bottom: 1px solid var(--border);
            text-align: left;
        }

        .verb-table th {
            background: var(--surface);
            color: var(--muted);
            font-weight: 600;
            position: sticky;
            top: 0;
        }

        .verb-table td strong { color: var(--primary); }

        .verb-mastery {
            display: inline-block;
            width: 10px;
            height: 10px;
            border-radius: 50%;
            margin-right: 6px;
            vertical-align: middle;
        }

        .mastery-new { background: #94a3b8; }
        .mastery-learning { background: #f59e0b; }
        .mastery-mastered { background: var(--correct); }
        .mastery-weak { background: var(--wrong); }

        .filter-row {
            display: flex;
            gap: 6px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .filter-btn {
            background: var(--surface);
            border: 1px solid var(--border);
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            color: var(--muted);
        }

        .filter-btn.active {
            background: var(--primary);
            color: white;
            border-color: var(--primary);
        }

        .reset-btn {
            background: #fee2e2;
            border: 1px solid #fecaca;
            color: var(--wrong);
            padding: 4px 10px;
            border-radius: 12px;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            margin-left: auto;
        }

        .reset-btn:hover { background: #fecaca; }
    

/* ================= GAMING SKIN + RICH ANIMATIONS ================= */
:root {
    --primary: #7c3aed;
    --primary-hover: #6d28d9;
    --bg: #080d1c;
    --card-bg: rgba(17, 25, 48, .94);
    --text: #eef2ff;
    --muted: #a5b4d4;
    --correct: #34d399;
    --wrong: #fb7185;
    --border: rgba(148, 163, 214, .22);
    --surface: rgba(30, 41, 75, .72);
    --neon: #8b5cf6;
}
* { -webkit-tap-highlight-color: transparent; }
body {
    background:
      radial-gradient(ellipse at 12% 8%, rgba(124,58,237,.24), transparent 34%),
      radial-gradient(ellipse at 88% 82%, rgba(14,165,233,.18), transparent 32%),
      linear-gradient(145deg, #070b17 0%, #10172e 52%, #080d1c 100%);
    background-attachment: fixed;
    color: var(--text);
    overflow-x: hidden;
}
body::before, body::after {
    content: "";
    position: fixed;
    width: 360px; height: 360px;
    border-radius: 50%;
    filter: blur(85px);
    opacity: .13;
    pointer-events: none;
    z-index: -1;
    animation: ambientFloat 14s ease-in-out infinite alternate;
}
body::before { background: #8b5cf6; top: -150px; left: -130px; }
body::after { background: #06b6d4; bottom: -180px; right: -120px; animation-delay: -6s; }
.container {
    background: linear-gradient(155deg, rgba(23,32,59,.97), rgba(12,19,39,.97));
    border: 1px solid rgba(167,139,250,.28);
    border-radius: 24px;
    box-shadow: 0 25px 70px rgba(0,0,0,.48), 0 0 35px rgba(124,58,237,.12), inset 0 1px rgba(255,255,255,.06);
    backdrop-filter: blur(18px);
    max-width: 560px;
    position: relative;
    overflow: hidden;
    animation: appEnter .65s cubic-bezier(.2,.8,.2,1) both;
}
.container::before {
    content: "";
    position: absolute; inset: 0 0 auto;
    height: 3px;
    background: linear-gradient(90deg, #22d3ee, #8b5cf6, #ec4899, #22d3ee);
    background-size: 250% 100%;
    animation: gradientRun 5s linear infinite;
}
.header h1 {
    color: #c4b5fd;
    text-shadow: 0 0 22px rgba(167,139,250,.38);
    letter-spacing: -.5px;
}
.btn-list, .filter-btn, .reset-btn, .btn-translate {
    border-radius: 12px;
    transition: transform .2s ease, box-shadow .2s ease, background .2s ease;
}
.btn-list {
    background: rgba(99,102,241,.13);
    color: #dbeafe;
    border-color: rgba(129,140,248,.28);
}
.btn-list:hover:not(:disabled) {
    transform: translateY(-2px);
    box-shadow: 0 7px 18px rgba(99,102,241,.2);
    background: rgba(99,102,241,.25);
}
.stats {
    color: #cbd5e1;
    border-bottom-color: rgba(148,163,214,.2);
}
.progress-container {
    height: 9px;
    border-radius: 20px;
    background: rgba(148,163,214,.16);
    box-shadow: inset 0 2px 5px rgba(0,0,0,.25);
}
.progress-bar {
    background: linear-gradient(90deg, #22d3ee, #8b5cf6, #d946ef);
    background-size: 200% 100%;
    box-shadow: 0 0 13px rgba(139,92,246,.65);
    animation: progressGlow 3s linear infinite;
}
.card {
    background: linear-gradient(145deg, rgba(40,52,91,.94), rgba(24,34,65,.94));
    border: 1px solid rgba(167,139,250,.28);
    border-radius: 19px;
    box-shadow: 0 12px 28px rgba(0,0,0,.22), inset 0 1px rgba(255,255,255,.06);
    overflow: hidden;
}
.card::after {
    content: "";
    position: absolute;
    inset: -80% -30%;
    background: linear-gradient(110deg, transparent 43%, rgba(255,255,255,.055) 50%, transparent 57%);
    transform: translateX(-70%);
    animation: cardShine 7s ease-in-out infinite;
    pointer-events: none;
}
.card .french-word {
    color: #f5f3ff;
    text-shadow: 0 0 24px rgba(167,139,250,.24);
    font-size: 1.65rem;
}
.card .base-verb { color: #a5b4fc; }
.btn-speak {
    color: #c4b5fd;
    filter: drop-shadow(0 0 8px rgba(167,139,250,.45));
}
input[type="text"] {
    background: rgba(8,14,30,.78);
    color: #f8fafc;
    border: 1px solid rgba(148,163,214,.3);
    border-radius: 12px;
}
input[type="text"]:focus {
    border-color: #a78bfa;
    box-shadow: 0 0 0 3px rgba(139,92,246,.16), 0 0 18px rgba(139,92,246,.12);
}
.input-group label { color: #c4b5fd; }
.btn {
    background: linear-gradient(110deg, #7c3aed, #6366f1 55%, #8b5cf6);
    box-shadow: 0 7px 20px rgba(124,58,237,.28), inset 0 1px rgba(255,255,255,.18);
    border-radius: 12px;
    transition: transform .18s ease, box-shadow .18s ease, filter .18s ease;
}
.btn:hover {
    background: linear-gradient(110deg, #8b5cf6, #6366f1 55%, #a78bfa);
    transform: translateY(-2px);
    box-shadow: 0 11px 25px rgba(124,58,237,.4);
}
.btn:active { transform: scale(.97); }
.btn-dont-know {
    background: rgba(148,163,184,.18);
    color: #e2e8f0;
    border: 1px solid rgba(148,163,184,.24);
    box-shadow: none;
}
.btn-dont-know:hover { background: rgba(148,163,184,.28); }
.feedback {
    border: 1px solid transparent;
    box-shadow: 0 8px 22px rgba(0,0,0,.16);
}
.feedback.correct {
    background: rgba(16,185,129,.13);
    color: #6ee7b7;
    border-color: rgba(52,211,153,.35);
}
.feedback.wrong {
    background: rgba(244,63,94,.12);
    color: #fda4af;
    border-color: rgba(251,113,133,.3);
    animation: shakeSoft .38s ease;
}
.bubble-section {
    background: rgba(15,23,48,.82);
    border: 1px solid rgba(129,140,248,.28);
    border-radius: 17px;
}
.bubble-title { color: #c4b5fd; }
.sentence { color: #e2e8f0; }
.bubble-btn {
    background: rgba(30,41,75,.9);
    color: #e2e8f0;
    border-color: rgba(148,163,214,.28);
    border-radius: 14px;
}
.bubble-btn:hover:not(:disabled) {
    background: rgba(99,102,241,.2);
    border-color: #a78bfa;
    transform: translateY(-3px) scale(1.03);
    box-shadow: 0 8px 18px rgba(99,102,241,.18);
}
.bubble-btn.correct-bubble {
    background: rgba(16,185,129,.18) !important;
    color: #6ee7b7 !important;
    box-shadow: 0 0 18px rgba(52,211,153,.18);
}
.bubble-btn.wrong-bubble {
    background: rgba(244,63,94,.16) !important;
    color: #fda4af !important;
}
.explanation-box.correct {
    background: rgba(16,185,129,.12);
    border-color: rgba(52,211,153,.28);
    color: #d1fae5;
}
.explanation-box.wrong {
    background: rgba(244,63,94,.1);
    border-color: rgba(251,113,133,.25);
    color: #ffe4e6;
}
.explanation-section { border-top-color: rgba(148,163,184,.2); }
.next-card-btn {
    background: linear-gradient(100deg, #312e81, #6d28d9);
    border: 1px solid rgba(167,139,250,.28);
    border-radius: 12px;
    box-shadow: 0 8px 20px rgba(79,70,229,.2);
    transition: transform .2s ease, box-shadow .2s ease;
}
.next-card-btn:hover { background: linear-gradient(100deg, #4338ca, #7c3aed); transform: translateY(-2px); }
.modal { background: rgba(2,6,23,.78); backdrop-filter: blur(9px); }
.modal-content {
    background: linear-gradient(145deg, #1e293b, #111827);
    border: 1px solid rgba(167,139,250,.28);
    color: #e2e8f0;
    box-shadow: 0 25px 80px rgba(0,0,0,.55);
    border-radius: 20px;
}
.modal-header { border-bottom-color: rgba(148,163,184,.2); }
.modal-header h2 { color: #c4b5fd; }
.verb-table th { background: #1e293b; color: #cbd5e1; }
.verb-table td { border-bottom-color: rgba(148,163,184,.15); }
.verb-table td strong { color: #c4b5fd; }
.filter-btn { background: rgba(51,65,85,.7); color: #cbd5e1; border-color: rgba(148,163,184,.2); }
.filter-btn.active { background: #6d28d9; color: white; }
.reset-btn { background: rgba(244,63,94,.14); color: #fda4af; border-color: rgba(251,113,133,.25); }
.close-btn { color: #cbd5e1; }
.mastery-learning { background: #fbbf24; }

@keyframes ambientFloat { from { transform: translate3d(0,0,0) scale(1); } to { transform: translate3d(65px,45px,0) scale(1.18); } }
@keyframes appEnter { from { opacity: 0; transform: translateY(18px) scale(.985); } to { opacity: 1; transform: translateY(0) scale(1); } }
@keyframes gradientRun { to { background-position: 250% 0; } }
@keyframes progressGlow { to { background-position: 200% 0; } }
@keyframes cardShine { 0%, 35% { transform: translateX(-70%); } 65%, 100% { transform: translateX(70%); } }
@keyframes shakeSoft { 0%,100% { transform: translateX(0); } 25% { transform: translateX(-3px); } 75% { transform: translateX(3px); } }
@keyframes floatUp { to { transform: translate(var(--dx), -125px) rotate(var(--rot)); opacity: 0; } }
