            variants: [
                {
                    sentence: "The book was _____ to me by a friend.", sentenceFr: "Le livre m'a été donné par un ami.",
                    answer: "given", options: ["give", "gave", "given"],
                    rule: "<b>Voix passive (WAS + Participe Passé)</b>.",
                    reason: "Le sujet subit l'action. L'auxiliaire passif exige le participe passé 'given'.",
                    example: "<i>She gave me a nice present.</i>",
                    deepDive: "Voix passive : ne jamais mettre le prétérit 'gave' après un auxiliaire be."
                }
            ]
        },
        { 
            fr: "Aller", bv: "Go", preterit: "went", pp: "gone", 
            variants: [
                {
                    sentence: "He has _____ to the supermarket for groceries.", sentenceFr: "Il est allé au supermarché pour faire des courses.",
                    answer: "gone", options: ["go", "went", "gone"],
                    rule: "<b>Present Perfect (HAS + Participe Passé)</b>.",
                    reason: "Action accomplie avec conséquence présente. On utilise le participe passé 'gone'.",
                    example: "<i>They went to Spain for their holidays last year.</i>",
                    deepDive: "'Go' change totalement de radical au prétérit ('went')."
                }
            ]
        },
        { 
            fr: "Entendre", bv: "Hear", preterit: "heard", pp: "heard", 
            variants: [
                {
                    sentence: "I _____ a strange noise outside.", sentenceFr: "J'ai entendu un bruit étrange dehors.",
                    answer: "heard", options: ["hear", "heard", "hearing"],
                    rule: "<b>Prétérit simple</b>.",
                    reason: "Perception passée et révolue. Le prétérit est 'heard'.",
                    example: "<i>She heard the good news this morning.</i>",
                    deepDive: "Attention à l'orthographe de 'heard' qui intègre un 'a'."
                }
            ]
        },
        { 
            fr: "Savoir / Connaître", bv: "Know", preterit: "knew", pp: "known", 
            variants: [
                {
                    sentence: "We have _____ each other for ten years.", sentenceFr: "Nous nous connaissons depuis dix ans.",
                    answer: "known", options: ["know", "knew", "known"],
                    rule: "<b>Present Perfect (HAVE + Participe Passé)</b>.",
                    reason: "État persistant depuis le passé lié au présent.",
                    example: "<i>He knew the answer right away.</i>",
                    deepDive: "Prononciation du prétérit 'knew' identique à 'new'."
                }
            ]
        },
        { 
            fr: "Lire", bv: "Read", preterit: "read", pp: "read", 
            variants: [
                {
                    sentence: "She _____ an interesting book last week.", sentenceFr: "Elle a lu un livre intéressant la semaine dernière.",
                    answer: "read", options: ["read", "red", "reading"],
                    rule: "<b>Prétérit simple</b>.",
                    reason: "Action passée de lecture. L'orthographe reste 'read' à tous les temps.",
                    example: "<i>He read the whole report in one hour.</i>",
                    deepDive: "S'écrit 'read' partout, mais se prononce [réd] au prétérit et au participe passé."
                }
            ]
        },
        { 
            fr: "Voir", bv: "See", preterit: "saw", pp: "seen", 
            variants: [
                {
                    sentence: "Have you _____ my keys anywhere?", sentenceFr: "As-tu vu mes clés quelque part ?",
                    answer: "seen", options: ["see", "saw", "seen"],
                    rule: "<b>Present Perfect interrogatif (HAVE + Participe Passé)</b>.",
                    reason: "L'auxiliaire 'have' impose l'emploi du participe passé 'seen'.",
                    example: "<i>I saw a great movie last night.</i>",
                    deepDive: "See / Saw / Seen : construction classique en -en."
                }
            ]
        },
        { 
            fr: "Parler", bv: "Speak", preterit: "spoke", pp: "spoken", 
            variants: [
                {
                    sentence: "She has already _____ to the manager.", sentenceFr: "Elle a déjà parlé au gérant.",
                    answer: "spoken", options: ["speak", "spoke", "spoken"],
                    rule: "<b>Present Perfect (HAS + Participe Passé)</b>.",
                    reason: "L'auxiliaire 'has' exige le participe passé en -en ('spoken').",
                    example: "<i>He spoke about his experience.</i>",
                    deepDive: "Ne pas confondre le prétérit 'spoke' avec le participe passé 'spoken'."
                }
            ]
        },
        { 
            fr: "Écrire", bv: "Write", preterit: "wrote", pp: "written", 
            variants: [
                {
                    sentence: "A formal letter was _____ by the director.", sentenceFr: "Une lettre officielle a été écrite par le directeur.",
                    answer: "written", options: ["write", "wrote", "written"],
                    rule: "<b>Voix passive (WAS + Participe Passé)</b>.",
                    reason: "Le sujet subit l'action. Après 'was', on met le participe passé 'written'.",
                    example: "<i>She wrote a nice postcard to her parents.</i>",
                    deepDive: "Le participe passé 'written' double le 't' et prend un -en final."
                }
            ]
        }
    ];

    // ===================== ÉTAT GLOBAL =====================
    const STORAGE_KEY = 'verbApp_v2';
    let questionQueue = [];
    let currentItem = null;
    let currentVariantRef = null;
    let score = 0;
    let phase = 'input';
    let isFrench = false;
    let mode = 'normal';
    let totalAtStart = 0;
    let currentFilter = 'all';

    let verbStats = {};

    // ===================== PERSISTANCE =====================
    function saveState() {
        try {
            localStorage.setItem(STORAGE_KEY, JSON.stringify({
                score,
                verbStats,
                mode
            }));
        } catch (e) { /* quota */ }
    }

    function loadState() {
        try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (!raw) return;
            const data = JSON.parse(raw);
            score = data.score || 0;
            verbStats = data.verbStats || {};
            mode = data.mode || 'normal';
        } catch (e) { /* corrupt */ }
    }

    function getVerbStat(bv) {
        if (!verbStats[bv]) {
            verbStats[bv] = { correct: 0, wrong: 0, mastered: false };
        }
        return verbStats[bv];
    }

    function updateVerbStat(bv, isCorrect) {
        const s = getVerbStat(bv);
        if (isCorrect) {
            s.correct++;
            if (s.correct >= 2 && s.wrong === 0) s.mastered = true;
            if (s.correct >= 3) s.mastered = true;
        } else {
            s.wrong++;
            s.mastered = false;
        }
        saveState();
    }

    function resetProgress() {
        if (!confirm("Effacer toute la progression (score + stats) ?")) return;
        verbStats = {};
        score = 0;
        saveState();
        document.getElementById('score').textContent = score;
        updateReviewButton();
        renderVerbTable();
    }

    // ===================== FILE D'ATTENTE =====================
    function initQueue() {
        questionQueue = [];
        verbsDatabase.forEach((verbObj) => {
            verbObj.variants.forEach((variantObj) => {
                questionQueue.push({
                    fr: verbObj.fr,
                    bv: verbObj.bv,
                    preterit: verbObj.preterit,
                    pp: verbObj.pp,
                    ...variantObj
                });
            });
        });
        shuffle(questionQueue);
        totalAtStart = questionQueue.length;
    }

    function initReviewQueue() {
        questionQueue = [];
        verbsDatabase.forEach((verbObj) => {
            const stat = getVerbStat(verbObj.bv);
            if (stat.wrong > 0 && !stat.mastered) {
                verbObj.variants.forEach((variantObj) => {
                    questionQueue.push({
                        fr: verbObj.fr,
                        bv: verbObj.bv,
                        preterit: verbObj.preterit,
                        pp: verbObj.pp,
                        ...variantObj
                    });
                });
            }
        });
        shuffle(questionQueue);
        totalAtStart = questionQueue.length;
    }

    function shuffle(arr) {
        for (let i = arr.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [arr[i], arr[j]] = [arr[j], arr[i]];
        }
    }

    function updateReviewButton() {
        const weakCount = verbsDatabase.filter(v => {
            const s = getVerbStat(v.bv);
            return s.wrong > 0 && !s.mastered;
        }).length;
        const btn = document.getElementById('review-btn');
        btn.textContent = weakCount > 0 ? `🎯 Mes erreurs (${weakCount})` : '🎯 Mes erreurs';
        btn.disabled = weakCount === 0;
    }

    function startReviewMode() {
        mode = 'review';
        document.getElementById('mode-label').textContent = 'Mode : révision';
        initReviewQueue();
        if (questionQueue.length === 0) {
            alert("Aucune erreur à réviser. Bravo ! 🎉");
            mode = 'normal';
            document.getElementById('mode-label').textContent = 'Mode : normal';
            return;
        }
        saveState();
        loadQuestion();
    }

    function startNormalMode() {
        mode = 'normal';
        document.getElementById('mode-label').textContent = 'Mode : normal';
        initQueue();
        saveState();
        loadQuestion();
    }

    // ===================== UI =====================
    function updateProgress() {
        const remaining = questionQueue.length + (currentItem ? 1 : 0);
        const bar = document.getElementById('progress-bar');
        const done = totalAtStart > 0 ? (totalAtStart - remaining) / totalAtStart : 0;
        bar.style.width = Math.max(0, Math.min(100, done * 100)) + '%';
        document.getElementById('remaining-label').textContent = remaining > 0 ? remaining : '✓';
    }

    function loadQuestion() {
        if (!currentItem) {
            // première fois
        }
        if (questionQueue.length === 0) {
            if (mode === 'review') {
                document.getElementById('feedback').innerHTML = "🎉 Révision terminée ! Retour au mode normal.";
                document.getElementById('feedback').className = "feedback correct";
                setTimeout(() => {
                    mode = 'normal';
                    document.getElementById('mode-label').textContent = 'Mode : normal';
                    initQueue();
                    loadQuestion();
                }, 1500);
                return;
            }
            initQueue();
        }

        currentItem = questionQueue.pop();
        updateProgress();

        phase = 'input';
        isFrench = false;

        document.getElementById('french-word').textContent = currentItem.fr;
        document.getElementById('base-verb').textContent = "Base verbale : " + currentItem.bv;
        document.getElementById('preterit').value = '';
        document.getElementById('past-participle').value = '';
        document.getElementById('preterit').disabled = false;
        document.getElementById('past-participle').disabled = false;
        document.getElementById('preterit').classList.remove('input-correct', 'input-wrong');
        document.getElementById('past-participle').classList.remove('input-correct', 'input-wrong');

        document.getElementById('feedback').className = 'feedback';
        document.getElementById('feedback').textContent = '';
        document.getElementById('submit-btn').style.display = 'block';

        document.getElementById('bubble-section').style.display = 'none';
        document.getElementById('explanation-box').className = 'explanation-box';
        document.getElementById('next-card-btn').style.display = 'none';
        document.getElementById('translate-btn').textContent = "🇫🇷 Traduire";
        document.getElementById('translate-btn').style.background = "#e2e8f0";
        document.getElementById('translate-btn').style.color = "#475569";
        document.getElementById('preterit').focus();

        const card = document.querySelector('.card');
        card.style.animation = 'none';
        void card.offsetWidth;
        card.style.animation = 'fadeIn 0.3s ease';
    }

    function toggleTranslation() {
        isFrench = !isFrench;
        const sentenceText = document.getElementById('sentence-text');
        const translateBtn = document.getElementById('translate-btn');

        if (isFrench) {
            sentenceText.textContent = currentItem.sentenceFr;
            translateBtn.textContent = "🇬🇧 Anglais";
            translateBtn.style.background = "#bfdbfe";
            translateBtn.style.color = "#1e40af";
        } else {
            sentenceText.textContent = currentItem.sentence;
            translateBtn.textContent = "🇫🇷 Traduire";
            translateBtn.style.background = "#e2e8f0";
            translateBtn.style.color = "#475569";
        }
    }

    function handleDontKnow() {
        const preteritField = document.getElementById('preterit');
        const ppField = document.getElementById('past-participle');
        
        preteritField.value = currentItem.preterit.split(' / ')[0];
        ppField.value = currentItem.pp.split(' / ')[0];
        
        preteritField.disabled = true;
        ppField.disabled = true;
        preteritField.classList.add('input-wrong');
        ppField.classList.add('input-wrong');
        document.getElementById('submit-btn').style.display = 'none';

        playSound(false);
        triggerVibration(false);

        updateVerbStat(currentItem.bv, false);

        const feedbackEl = document.getElementById('feedback');
        feedbackEl.innerHTML = "💡 Voici les réponses. À vous de jouer pour la phrase ci-dessous !";
        feedbackEl.className = "feedback wrong";

        setupBubbleExercise();
        phase = 'bubble';
        updateReviewButton();
    }

    function handleSubmit(e) {
        e.preventDefault();
        if (phase !== 'input') return;

        const userPreterit = document.getElementById('preterit').value.trim().toLowerCase();
        const userPp = document.getElementById('past-participle').value.trim().toLowerCase();

        const validPreterits = currentItem.preterit.toLowerCase().split(' / ');
        const validPps = currentItem.pp.toLowerCase().split(' / ');

        const isPreteritCorrect = validPreterits.includes(userPreterit);
        const isPpCorrect = validPps.includes(userPp);

        const preteritInput = document.getElementById('preterit');
        const ppInput = document.getElementById('past-participle');
        preteritInput.classList.toggle('input-correct', isPreteritCorrect);
        preteritInput.classList.toggle('input-wrong', !isPreteritCorrect);
        ppInput.classList.toggle('input-correct', isPpCorrect);
        ppInput.classList.toggle('input-wrong', !isPpCorrect);

        const feedbackEl = document.getElementById('feedback');
        const bothCorrect = isPreteritCorrect && isPpCorrect;
        const anyCorrect = isPreteritCorrect || isPpCorrect;

        let points = 0;
        if (isPreteritCorrect) points += 5;
        if (isPpCorrect) points += 5;
        score += points;

        updateVerbStat(currentItem.bv, bothCorrect);

        if (bothCorrect) {
            playSound(true);
            triggerVibration(true);
            feedbackEl.textContent = "Exact pour les verbes ! Analysez maintenant le contexte de la phrase :";
            feedbackEl.className = "feedback correct";
        } else if (anyCorrect) {
            playSound(false);
            triggerVibration(false);
            feedbackEl.innerHTML = "Partiellement correct (+" + points + " pts).<br>Formes attendues : <strong>" + currentItem.preterit + "</strong> / <strong>" + currentItem.pp + "</strong>";
            feedbackEl.className = "feedback wrong";
        } else {
            playSound(false);
            triggerVibration(false);
            feedbackEl.innerHTML = "Attention ❌<br>Formes attendues : <strong>" + currentItem.preterit + "</strong> / <strong>" + currentItem.pp + "</strong>";
            feedbackEl.className = "feedback wrong";
        }

        document.getElementById('score').textContent = score;
        if (points > 0) window.showGamingReward && window.showGamingReward(points, bothCorrect);
        saveState();
        updateReviewButton();

        preteritInput.disabled = true;
        ppInput.disabled = true;
        document.getElementById('submit-btn').style.display = 'none';

        setupBubbleExercise();
        phase = 'bubble';
    }

    function setupBubbleExercise() {
        const bubbleSection = document.getElementById('bubble-section');
        const sentenceText = document.getElementById('sentence-text');
        const bubblesContainer = document.getElementById('bubbles-container');

        isFrench = false;
        document.getElementById('translate-btn').textContent = "🇫🇷 Traduire";
        document.getElementById('translate-btn').style.background = "#e2e8f0";
        document.getElementById('translate-btn').style.color = "#475569";

        sentenceText.textContent = currentItem.sentence;
        bubblesContainer.innerHTML = '';

        let shuffledOptions = [...currentItem.options].sort(() => Math.random() - 0.5);

        shuffledOptions.forEach((option, idx) => {
            const btn = document.createElement('button');
            btn.type = 'button';
            btn.className = 'bubble-btn';
            btn.textContent = option;
            btn.dataset.option = option;
            btn.onclick = function() { checkBubble(option); };
            bubblesContainer.appendChild(btn);
        });

        bubbleSection.style.display = 'block';
    }

    function checkBubble(selectedOption) {
        const buttons = document.querySelectorAll('.bubble-btn');
        const isCorrect = selectedOption.toLowerCase() === currentItem.answer.toLowerCase();

        playSound(isCorrect);
        triggerVibration(isCorrect);

        buttons.forEach(btn => {
            btn.disabled = true;
            if (btn.textContent.toLowerCase() === currentItem.answer.toLowerCase()) {
                btn.classList.add('correct-bubble');
            } else if (btn.textContent.toLowerCase() === selectedOption.toLowerCase()) {
                btn.classList.add('wrong-bubble');
            }
        });

        if (isCorrect) {
            score += 5;
            updateVerbStat(currentItem.bv, true);
        } else {
            updateVerbStat(currentItem.bv, false);
        }
        document.getElementById('score').textContent = score;
        if (isCorrect) window.showGamingReward && window.showGamingReward(5, true);
        saveState();
        updateReviewButton();

        showDetailedExplanation(isCorrect);
    }

    function showDetailedExplanation(isCorrect) {
        const explanationBox = document.getElementById('explanation-box');
        const nextBtn = document.getElementById('next-card-btn');

        const htmlExplanation = 
            '<span class="explanation-title">' + (isCorrect ? '✅ Analyse détaillée : Correct !' : '📖 Analyse détaillée & Correction') + '</span>' +
            '<div><strong>1. Règle grammaticale :</strong> ' + currentItem.rule + '</div>' +
            '<div class="explanation-section"><strong>2. Explication logique :</strong><br>' + currentItem.reason + '</div>' +
            '<div class="explanation-section"><strong>3. Exemple similaire :</strong><br>' + currentItem.example + '</div>' +
            '<div class="explanation-section" style="color: #1e3a8a; background: #eff6ff; padding: 10px; border-radius: 6px; border-left: 4px solid #2563eb; margin-top: 10px;"><strong>4. Décryptage approfondi :</strong><br>' + currentItem.deepDive + '</div>';

        explanationBox.innerHTML = htmlExplanation;
        explanationBox.className = 'explanation-box ' + (isCorrect ? 'correct' : 'wrong');

        nextBtn.style.display = 'block';
        nextBtn.focus();
    }

    // ===================== MODAL =====================
    function openModal() {
        renderVerbTable();
        document.getElementById('verb-modal').style.display = 'flex';
        document.querySelector('.close-btn').focus();
    }

    function closeModal() {
        document.getElementById('verb-modal').style.display = 'none';
    }

    function setFilter(filter) {
        currentFilter = filter;
        document.querySelectorAll('.filter-btn').forEach(b => {
            b.classList.toggle('active', b.dataset.filter === filter);
        });
        renderVerbTable();
    }

    function renderVerbTable() {
        const tbody = document.getElementById('verb-table-body');
        tbody.innerHTML = '';

        verbsDatabase.forEach(v => {
            const s = getVerbStat(v.bv);
            let filterMatch = true;
            if (currentFilter === 'weak') filterMatch = s.wrong > 0 && !s.mastered;
            else if (currentFilter === 'mastered') filterMatch = s.mastered;
            else if (currentFilter === 'new') filterMatch = s.correct === 0 && s.wrong === 0;

            if (!filterMatch) return;

            let masteryClass = 'mastery-new';
            let masteryLabel = 'Nouveau';
            if (s.mastered) { masteryClass = 'mastery-mastered'; masteryLabel = 'Maîtrisé'; }
            else if (s.wrong > 0) { masteryClass = 'mastery-weak'; masteryLabel = 'À revoir'; }
            else if (s.correct > 0) { masteryClass = 'mastery-learning'; masteryLabel = 'En cours'; }

            const tr = document.createElement('tr');
            tr.innerHTML =
                '<td><span class="verb-mastery ' + masteryClass + '" title="' + masteryLabel + '"></span>' + masteryLabel + '</td>' +
                '<td>' + v.fr + '</td>' +
                '<td><strong>' + v.bv + '</strong></td>' +
                '<td>' + v.preterit + ' / ' + v.pp + '</td>';
            tbody.appendChild(tr);
        });

        if (tbody.children.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;color:var(--muted);padding:20px;">Aucun verbe dans cette catégorie.</td></tr>';
        }
    }

    // ===================== CLAVIER =====================
    document.addEventListener('keydown', function(e) {
        if (e.key === 'Escape') {
            closeModal();
            return;
        }

        if (phase === 'bubble' && ['1', '2', '3'].includes(e.key)) {
            const buttons = document.querySelectorAll('.bubble-btn');
            const idx = parseInt(e.key) - 1;
            if (buttons[idx] && !buttons[idx].disabled) {
                buttons[idx].click();
            }
        }

        if (e.key === 'Enter') {
            const nextBtn = document.getElementById('next-card-btn');
            if (nextBtn.style.display === 'block' && document.activeElement !== document.getElementById('submit-btn')) {
                // évite le double submit
            }
        }
    });

    window.onclick = function(event) {
        const modal = document.getElementById('verb-modal');
        if (event.target === modal) closeModal();
    };

    // ===================== INIT =====================
    loadState();
    document.getElementById('score').textContent = score;
    updateReviewButton();
    attachSanitizers();

    if (mode === 'review') {
        startReviewMode();
    } else {
        initQueue();
        loadQuestion();
    }


    // ===================== EFFETS VISUELS GAMING =====================
    (function initGamingEffects() {
        const layer = document.createElement('div');
        layer.className = 'particle-layer';
        layer.setAttribute('aria-hidden', 'true');
        document.body.appendChild(layer);

        window.showGamingReward = function(points, celebrate) {
            const label = document.createElement('div');
            label.className = 'xp-float';
            label.textContent = '+' + points + ' XP';
            document.body.appendChild(label);
            setTimeout(() => label.remove(), 1200);

            if (!celebrate) return;
            const palette = ['#a78bfa', '#22d3ee', '#f0abfc', '#34d399', '#fbbf24'];
            const count = 34;
            for (let i = 0; i < count; i++) {
                const p = document.createElement('i');
                p.className = 'game-particle';
                const angle = (Math.PI * 2 * i) / count;
                const distance = 65 + Math.random() * 105;
                p.style.setProperty('--x', '50%');
                p.style.setProperty('--y', '44%');
                p.style.setProperty('--dx', Math.cos(angle) * distance + 'px');
                p.style.setProperty('--rot', (Math.random() * 720 - 360) + 'deg');
                p.style.setProperty('--size', (5 + Math.random() * 7) + 'px');
                p.style.setProperty('--radius', Math.random() > .45 ? '50%' : '2px');
                p.style.setProperty('--color', palette[Math.floor(Math.random() * palette.length)]);
                p.style.setProperty('--duration', (850 + Math.random() * 750) + 'ms');
                layer.appendChild(p);
                setTimeout(() => p.remove(), 1700);
            }
            const card = document.querySelector('.card');
            if (card) {
                card.classList.remove('correct-celebrate');
                void card.offsetWidth;
                card.classList.add('correct-celebrate');
                setTimeout(() => card.classList.remove('correct-celebrate'), 650);
            }
        };
    })();

    // Tick au survol du 🔊 (après première interaction)
    const speakBtnEl = document.querySelector('.btn-speak');
    if (speakBtnEl) {
        speakBtnEl.addEventListener('mouseenter', () => {
            if (userHasInteracted) playTick();
        });
    }

</script>

