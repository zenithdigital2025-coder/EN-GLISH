    // ===================== AUDIO MODERNE + ANTI-COUPURE =====================
    let audioCtx = null;
    let masterGain = null;
    let keepAliveOsc = null;
    let userHasInteracted = false;
    let lastPlayTime = 0;

    function ensureAudioContext() {
        if (!audioCtx) {
            const AC = window.AudioContext || window.webkitAudioContext;
            if (!AC) return null;
            audioCtx = new AC();

            masterGain = audioCtx.createGain();
            masterGain.gain.value = 1;
            masterGain.connect(audioCtx.destination);

            try {
                keepAliveOsc = audioCtx.createOscillator();
                const aliveGain = audioCtx.createGain();
                keepAliveOsc.type = 'sine';
                keepAliveOsc.frequency.value = 20;
                aliveGain.gain.value = 0.00001;
                keepAliveOsc.connect(aliveGain);
                aliveGain.connect(audioCtx.destination);
                keepAliveOsc.start();
            } catch (e) { /* ignore */ }
        }

        if (audioCtx.state === 'suspended') {
            audioCtx.resume().catch(() => {});
        }
        return audioCtx;
    }

    ['pointerdown', 'touchstart', 'keydown', 'click'].forEach(evt => {
        window.addEventListener(evt, () => {
            userHasInteracted = true;
            ensureAudioContext();
        }, { once: true, passive: true });
    });

    document.addEventListener('visibilitychange', () => {
        if (!document.hidden && audioCtx && audioCtx.state === 'suspended') {
            audioCtx.resume().catch(() => {});
        }
    });
    window.addEventListener('focus', () => {
        if (audioCtx && audioCtx.state === 'suspended') {
            audioCtx.resume().catch(() => {});
        }
    });

    function applyEnvelope(gain, ctx, peak, attack, decay, sustain, release, start, duration) {
        const t = ctx.currentTime + start;
        const safePeak = Math.max(peak, 0.0001);
        const safeSustain = Math.max(sustain, 0.0001);
        gain.gain.setValueAtTime(0.0001, t);
        gain.gain.exponentialRampToValueAtTime(safePeak, t + attack);
        gain.gain.exponentialRampToValueAtTime(safeSustain, t + attack + decay);
        const holdEnd = Math.max(t + attack + decay, t + duration - release);
        gain.gain.setValueAtTime(safeSustain, holdEnd);
        gain.gain.exponentialRampToValueAtTime(0.0001, t + duration);
    }

    function playNote(ctx, freq, startTime, duration, type, peak, detune = 0) {
        const osc = ctx.createOscillator();
        const osc2 = ctx.createOscillator();
        const gain = ctx.createGain();
        const gain2 = ctx.createGain();
        const filter = ctx.createBiquadFilter();

        osc.type = type;
        osc.frequency.setValueAtTime(freq, ctx.currentTime + startTime);
        osc.detune.setValueAtTime(detune, ctx.currentTime + startTime);

        osc2.type = 'sine';
        osc2.frequency.setValueAtTime(freq * 2, ctx.currentTime + startTime);
        gain2.gain.setValueAtTime(0.12, ctx.currentTime + startTime);

        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(4500, ctx.currentTime + startTime);
        filter.frequency.exponentialRampToValueAtTime(1800, ctx.currentTime + startTime + duration);
        filter.Q.value = 2;

        osc.connect(gain);
        osc2.connect(gain2);
        gain2.connect(gain);
        gain.connect(filter);
        filter.connect(masterGain);

        applyEnvelope(gain, ctx, peak, 0.008, 0.05, peak * 0.6, 0.08, startTime, duration);

        osc.start(ctx.currentTime + startTime);
        osc.stop(ctx.currentTime + startTime + duration + 0.02);
        osc2.start(ctx.currentTime + startTime);
        osc2.stop(ctx.currentTime + startTime + duration + 0.02);
    }

    function playTick() {
        try {
            const ctx = ensureAudioContext();
            if (!ctx) return;
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.type = 'square';
            osc.frequency.setValueAtTime(1400, ctx.currentTime);
            gain.gain.setValueAtTime(0.04, ctx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.05);
            osc.connect(gain);
            gain.connect(masterGain);
            osc.start(ctx.currentTime);
            osc.stop(ctx.currentTime + 0.06);
        } catch (e) {}
    }

    function playSound(isCorrect) {
        const now = performance.now();
        if (now - lastPlayTime < 80) return;
        lastPlayTime = now;

        try {
            const ctx = ensureAudioContext();
            if (!ctx) return;

            if (ctx.state === 'suspended') {
                ctx.resume().then(() => playSoundInternal(ctx, isCorrect)).catch(() => {});
            } else {
                playSoundInternal(ctx, isCorrect);
            }
        } catch (e) { /* silencieux */ }
    }

    function playSoundInternal(ctx, isCorrect) {
        if (isCorrect) {
            const notes = [523.25, 659.25, 783.99, 1046.50];
            notes.forEach((freq, i) => {
                playNote(ctx, freq, i * 0.075, 0.28, 'triangle', 0.16);
                playNote(ctx, freq * 2, i * 0.075, 0.22, 'sine', 0.05);
            });
            const pad = ctx.createOscillator();
            const padGain = ctx.createGain();
            pad.type = 'sine';
            pad.frequency.setValueAtTime(1046.5, ctx.currentTime);
            padGain.gain.setValueAtTime(0.0001, ctx.currentTime);
            padGain.gain.linearRampToValueAtTime(0.03, ctx.currentTime + 0.1);
            padGain.gain.exponentialRampToValueAtTime(0.0001, ctx.currentTime + 0.6);
            pad.connect(padGain);
            padGain.connect(masterGain);
            pad.start(ctx.currentTime);
            pad.stop(ctx.currentTime + 0.65);
        } else {
            const now = ctx.currentTime;
            const osc = ctx.createOscillator();
            const osc2 = ctx.createOscillator();
            const gain = ctx.createGain();
            const filter = ctx.createBiquadFilter();

            osc.type = 'sawtooth';
            osc.frequency.setValueAtTime(220, now);
            osc.frequency.exponentialRampToValueAtTime(90, now + 0.35);

            osc2.type = 'square';
            osc2.frequency.setValueAtTime(110, now);
            osc2.frequency.exponentialRampToValueAtTime(45, now + 0.35);

            filter.type = 'lowpass';
            filter.frequency.setValueAtTime(1200, now);
            filter.frequency.exponentialRampToValueAtTime(300, now + 0.35);
            filter.Q.value = 6;

            gain.gain.setValueAtTime(0.0001, now);
            gain.gain.linearRampToValueAtTime(0.13, now + 0.015);
            gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.4);

            osc.connect(filter);
            osc2.connect(filter);
            filter.connect(gain);
            gain.connect(masterGain);

            osc.start(now); osc.stop(now + 0.42);
            osc2.start(now); osc2.stop(now + 0.42);
        }
    }

    function playStreak() {
        try {
