            variants: [
                {
                    sentence: "Somebody has _____ my sandwich!", sentenceFr: "Quelqu'un a mangé mon sandwich !",
                    answer: "eaten", options: ["eat", "ate", "eaten"],
                    rule: "<b>Present Perfect (HAS + Participe Passé)</b>.",
                    reason: "L'auxiliaire 'has' impose le participe passé 'eaten'.",
                    example: "<i>We ate pizza last night.</i>",
                    deepDive: "Le participe passé 'eaten' prend une terminaison en -en."
                }
            ]
        },
        { 
            fr: "Trouver", bv: "Find", preterit: "found", pp: "found", 
            variants: [
                {
                    sentence: "She _____ her lost keys under the sofa.", sentenceFr: "Elle a trouvé ses clés perdues sous le canapé.",
                    answer: "found", options: ["find", "found", "finding"],
                    rule: "<b>Prétérit simple</b>.",
                    reason: "Action de découverte réalisée et terminée dans le passé.",
                    example: "<i>We found a great restaurant downtown.</i>",
                    deepDive: "Find / Found / Found : prétérit et participe passé strictement identiques."
                }
            ]
