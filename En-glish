    // ===================== SPEECH SYNTHESIS (voix anglaise forcée) =====================
    let cachedEnglishVoice = null;
    let voicesReady = false;

    function pickEnglishVoice() {
        if (!('speechSynthesis' in window)) return null;
        const voices = window.speechSynthesis.getVoices();
        if (!voices || voices.length === 0) return null;
        // Priorité : en-GB exact, puis en-GB-*, puis en-US, puis en-*
        return voices.find(v => v.lang === 'en-GB')
            || voices.find(v => v.lang && v.lang.toLowerCase().startsWith('en-gb'))
            || voices.find(v => v.lang === 'en-US')
            || voices.find(v => v.lang && v.lang.toLowerCase().startsWith('en-'))
            || null;
    }

    function refreshVoiceCache() {
        const v = pickEnglishVoice();
        if (v) {
            cachedEnglishVoice = v;
            voicesReady = true;
        }
    }

    if ('speechSynthesis' in window) {
        // Charger immédiatement si déjà disponible
        refreshVoiceCache();
        // Réagir au chargement asynchrone des voix
        window.speechSynthesis.onvoiceschanged = refreshVoiceCache;
        // Certains navigateurs (Chrome) déclenchent tardivement : re-essayer après un délai
        setTimeout(refreshVoiceCache, 500);
        setTimeout(refreshVoiceCache, 1500);
    }

    function speak(text, lang = 'en-GB') {
        if (!('speechSynthesis' in window)) return;

        // Cancel précédent
        window.speechSynthesis.cancel();

        // Si le cache est vide, retenter une fois
        if (!cachedEnglishVoice) refreshVoiceCache();

        const u = new SpeechSynthesisUtterance(text);
        u.lang = lang;
        u.rate = 0.9;
        u.pitch = 1;

        // Assigner explicitement la voix anglaise (force le navigateur à l'utiliser)
        if (cachedEnglishVoice) {
            u.voice = cachedEnglishVoice;
            // Sur certains navigateurs, redéfinir lang avec la voix fonctionne mieux
            u.lang = cachedEnglishVoice.lang || lang;
        }

        window.speechSynthesis.speak(u);
    }

